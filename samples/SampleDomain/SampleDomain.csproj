<Project Sdk="Microsoft.NET.Sdk">

  <!-- Domínio num projeto separado da API (como Domain × Application em projetos reais): os símbolos das entidades vêm
       de outra compilação quando resolvidos a partir da API. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
